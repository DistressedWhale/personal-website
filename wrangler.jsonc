{
  "name": "personal-website",
  "compatibility_date": "2026-11-01",
  // Cloudflare creates the DNS record and the certificate for a custom domain.
  "routes": [{ "pattern": "cetaceous.dev", "custom_domain": true }],
  // The Worker has no script. Cloudflare serves the files in public/ directly.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
